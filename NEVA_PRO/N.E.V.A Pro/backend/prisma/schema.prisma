generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model users {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String           @db.VarChar(255)
  email           String           @unique @db.VarChar(255)
  password_hash   String
  avatar_url      String?
  level           Int              @default(1)
  total_xp        Int              @default(0)
  current_streak  Int              @default(0)
  last_activity_at DateTime?      @db.Timestamptz(6)
  created_at      DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?        @default(now()) @db.Timestamptz(6)
  answers         answers[]
  xp_logs         xp_logs[]
  user_badges     user_badges[]

  @@map("users")
}

model questions {
  id              String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  text            String
  explanation     String?
  subject         String             @db.VarChar(100)
  difficulty      Difficulty
  created_at      DateTime?          @default(now()) @db.Timestamptz(6)
  question_options question_options[]
  answers         answers[]
  simulado_questions simulado_questions[]

  @@map("questions")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model question_options {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  question_id     String    @db.Uuid
  text            String
  is_correct      Boolean   @default(false)
  label           String    @db.Char(1)
  question        questions @relation(fields: [question_id], references: [id], onDelete: Cascade)
  answers         answers[]

  @@map("question_options")
}

model answers {
  id              BigInt            @id @default(autoincrement())
  user_id         String?           @db.Uuid
  question_id     String?           @db.Uuid
  option_id       String?           @db.Uuid
  external_id     String?           @db.VarChar(255)
  is_correct      Boolean
  response_time_ms Int?
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  user            users?            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question        questions?        @relation(fields: [question_id], references: [id])
  option          question_options? @relation(fields: [option_id], references: [id])

  @@map("answers")
}

model simulados {
  id              String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title           String             @db.VarChar(255)
  description     String?
  duration_minutes Int
  created_at      DateTime?          @default(now()) @db.Timestamptz(6)
  simulado_questions simulado_questions[]

  @@map("simulados")
}

model simulado_questions {
  simulado_id String    @db.Uuid
  question_id String    @db.Uuid
  order       Int
  simulado    simulados @relation(fields: [simulado_id], references: [id], onDelete: Cascade)
  questions   questions @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@id([simulado_id, question_id])
  @@map("simulado_questions")
}

model materials {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title       String    @db.VarChar(255)
  content_url String
  type        String    @db.VarChar(20)
  subject     String?   @db.VarChar(100)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@map("materials")
}

model xp_logs {
  id         BigInt    @id @default(autoincrement())
  user_id    String?   @db.Uuid
  amount     Int
  reason     String    @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  user       users?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("xp_logs")
}

model badges {
  id                String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name              String        @db.VarChar(100)
  description       String?
  icon_url          String
  requirement_type  String?       @db.VarChar(50)
  requirement_value Int?
  user_badges       user_badges[]

  @@map("badges")
}

model user_badges {
  user_id   String    @db.Uuid
  badge_id  String    @db.Uuid
  earned_at DateTime? @default(now()) @db.Timestamptz(6)
  user      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  badge     badges    @relation(fields: [badge_id], references: [id], onDelete: Cascade)

  @@id([user_id, badge_id])
  @@map("user_badges")
}

model mural {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title      String    @db.VarChar(255)
  content    String
  type       String?   @default("INFO") @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@map("mural")
}
